widget_class MoreVideoInfo {open
  xywh {0 0 547 466} hide
  code0 {this->label(_("Detailed Video Metadata"));}
  class Fl_Double_Window modal
} {
  Fl_Box vm_thumbnail {
    xywh {108 8 330 190} box UP_FRAME
  }
  Fl_Group vm_scroll {open
    xywh {0 200 547 266} align 65
    code0 {vm_scroll->type(Fl_Scroll::VERTICAL);}
    code1 {vm_scroll->scrollbar.align(FL_ALIGN_RIGHT | FL_ALIGN_TOP);}
    class Fl_Scroll
  } {}
  Fl_Box vm_retrieving_info {
    label {Retrieving video metadata...}
    xywh {22 218 503 30} labelfont 3 hide
  }
  decl {struct video_metadata {
    std::string key;
    std::string value;
};

std::vector<video_metadata> metadata_list;} {private local
  }
  Function {delete_all_metadata()} {
    comment {Clear all video metadata added to this window.} open return_type void
  } {
    code {metadata_list.clear();
vm_scroll->clear();} {}
  }
  Function {add_metadata(std::string k, std::string v)} {
    comment {Add a new metadata struct. Key is the "metadata title". Does not check if previously was added...} open return_type void
  } {
    code {if (k != "") {
    video_metadata vm;
    vm.key = k;
    vm.value = v;
    metadata_list.push_back(vm);
}} {}
  }
  Function {print_metadata()} {
    comment {Print metadata on screen.} open return_type void
  } {
    code {const int fixed_box_width = this->vm_scroll->w() - 20;
    int dyn_box_height = 0;
    int box_x = this->vm_scroll->x() + 10;
    int box_y = this->vm_scroll->y() + 10;

    for (video_metadata mtd: metadata_list) {
        //std::cout << mtd.key << " + " << mtd.value << "\\n";
        //std::cout << "X: " << box_x << " Y: " << box_y << "\\n";
        Fl_Box* box_key = new Fl_Box(box_x, box_y, fixed_box_width, 20);
        box_key->labelfont(FL_HELVETICA_BOLD);
        box_key->copy_label(mtd.key.c_str());
        box_key->align(FL_ALIGN_LEFT | FL_ALIGN_INSIDE | FL_ALIGN_WRAP);
        fl_font(this->vm_scroll->labelfont(), this->vm_scroll->labelsize());
        int box_width = fixed_box_width;
        fl_measure(mtd.value.c_str(), box_width, dyn_box_height, 1);
        //std::cout << "X: " << box_x << " Y: " << box_y + box_key->h() << " Box WIDTH: " << fixed_box_width << " HEIGHT: " << dyn_box_height <<"\\n";
        Fl_Box* box_value = new Fl_Box(box_x, box_y + box_key->h(), fixed_box_width, dyn_box_height);
        box_value->copy_label(mtd.value.c_str());
        box_value->align(FL_ALIGN_LEFT | FL_ALIGN_INSIDE | FL_ALIGN_WRAP);
        box_y = box_y + 20 + dyn_box_height + 10;
        this->vm_scroll->add(box_key);
        this->vm_scroll->add(box_value);
    }} {}
  }
}
